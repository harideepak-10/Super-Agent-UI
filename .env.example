# Django backend (no trailing slash). Defaults to the Render deployment used by the Flutter app.
VITE_API_URL=https://super-agent-platform.onrender.com
# Django Channels (WebSockets). Defaults to the API URL with ws(s)://
VITE_WS_URL=wss://super-agent-platform.onrender.com
# Google sign-in (same web client as the Flutter app). Your site's origin must be allowed in Google Cloud.
VITE_GOOGLE_CLIENT_ID=874181358790-qgc6h5mid481khegru1ub237du4qkk12.apps.googleusercontent.com

# Local Django instead:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
